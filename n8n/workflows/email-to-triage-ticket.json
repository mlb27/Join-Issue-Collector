      "name": "Is automation allowed?"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Classify this Join issue email. Return only JSON with title, category, priority, dueDate and description. Allowed category values: user-story, technical-task. Allowed priority values: low, medium, urgent. Use YYYY-MM-DD for dueDate. Sender: ' + $json.senderName + ' <' + $json.senderEmail + '> Subject: ' + $json.subject + ' Body: ' + $json.body }}"
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [
        -176,
        560
      ],
      "id": "ae13d86b-6771-489a-ad5e-4a9848fa7f0d",
      "name": "Classify request with AI",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Converts the AI result into the Join task shape and Firestore REST payload.\n */\nconst emailRequest = $(\"Extract email request\").first().json;\nconst aiOutput =\n  $input.first().json.output ?? $input.first().json.text ?? $input.first().json;\n\nlet parsed = {};\n\ntry {\n  parsed =\n    typeof aiOutput === \"string\"\n      ? JSON.parse(stripMarkdownCodeBlock(aiOutput))\n      : aiOutput;\n} catch {\n  parsed = {};\n}\n\nconst categories = new Set([\"user-story\", \"technical-task\"]);\nconst priorities = new Set([\"low\", \"medium\", \"urgent\"]);\nconst fallbackDate = new Date(Date.now() + 7 * 86400000)\n  .toISOString()\n  .slice(0, 10);\n\nconst task = {\n  title: String(parsed.title || emailRequest.subject || \"Stakeholder request\")\n    .trim()\n    .slice(0, 120),\n\n  description:\n    \"[AI-generated from stakeholder email]\\n\\n\" +\n    String(parsed.description || emailRequest.body).trim(),\n\n  dueDate: /^\\d{4}-\\d{2}-\\d{2}$/.test(String(parsed.dueDate || \"\"))\n    ? parsed.dueDate\n    : fallbackDate,\n\n  priority: priorities.has(parsed.priority) ? parsed.priority : \"medium\",\n\n  status: \"triage\",\n\n  category: categories.has(parsed.category) ? parsed.category : \"user-story\",\n\n  assignedTo: [],\n  subtasks: [],\n  source: \"email\",\n\n  creator: {\n    type: \"external\",\n    name: emailRequest.senderName,\n    email: emailRequest.senderEmail,\n    uid: \"\",\n  },\n};\n\nconst firestoreDocument = {\n  fields: {\n    title: { stringValue: task.title },\n    description: { stringValue: task.description },\n    dueDate: { stringValue: task.dueDate },\n    priority: { stringValue: task.priority },\n    status: { stringValue: task.status },\n    category: { stringValue: task.category },\n    assignedTo: { arrayValue: { values: [] } },\n    subtasks: { arrayValue: { values: [] } },\n    source: { stringValue: task.source },\n\n    creator: {\n      mapValue: {\n        fields: {\n          type: { stringValue: task.creator.type },\n          name: { stringValue: task.creator.name },\n          email: { stringValue: task.creator.email },\n          uid: { stringValue: task.creator.uid },\n        },\n      },\n    },\n\n    createdAt: { timestampValue: new Date().toISOString() },\n    updatedAt: { timestampValue: new Date().toISOString() },\n  },\n};\n\nreturn [\n  {\n    json: {\n      task,\n      firestoreDocument,\n      emailRequest,\n    },\n  },\n];\n\n/**\n * Removes Markdown code fences from the AI response.\n * @param {string} value\n * @returns {string}\n */\nfunction stripMarkdownCodeBlock(value) {\n  return String(value)\n    .trim()\n    .replace(/^```(?:json)?\\s*/i, \"\")\n    .replace(/\\s*```$/i, \"\")\n    .trim();\n}\n"
      },
