    {
      "parameters": {
        "jsCode": "/**\n * Extracts the sender, subject and message body from a Gmail trigger item.\n * The workflow keeps only normalized text values so later nodes never need\n * direct access to the raw email payload.\n */\nconst email = $input.first().json;\nconst headers = email.headers ?? {};\n\nconst from = String(\n  email.from ?? email.From ?? headers.from ?? headers.From ?? '',\n).trim();\n\nconst subject = String(\n  email.subject ?? email.Subject ?? headers.subject ?? headers.Subject ?? 'Untitled request',\n).trim();\n\nconst text = String(\n  email.textPlain ?? email.text ?? email.snippet ?? email.Snippet ?? '',\n).trim();\n\nconst html = String(email.textHtml ?? email.html ?? email.Html ?? '')\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst body = text || html || 'No email body was provided.';\nconst senderEmail = (from.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i) ?? [''])[0];\nconst senderName = from.replace(/<[^>]+>/g, '').replace(senderEmail, '').replace(/[\"<>]/g, '').trim() || senderEmail || 'External stakeholder';\n\nreturn [{\n  json: {\n    messageId: email.id ?? email.messageId ?? '',\n    threadId: email.threadId ?? '',\n    senderName,\n    senderEmail,\n    subject,\n    body,\n    receivedAt: new Date().toISOString(),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -848,
        704
      ],
      "id": "67cc3562-cd0e-4556-9607-a3a9ee18035c",
      "name": "Extract email request"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Applies the public daily automation limit.\n * The starter workflow stores the counter in n8n workflow static data; a\n * production setup can replace this with Firestore or another durable store.\n */\nconst request = $input.first().json;\nconst data = $getWorkflowStaticData('global');\nconst today = new Date().toISOString().slice(0, 10);\nif (data.requestQuotaDate !== today) {\n  data.requestQuotaDate = today;\n  data.requestQuotaUsed = 0;\n}\nconst used = Number(data.requestQuotaUsed ?? 0);\nconst dailyLimit = 10;\nconst limitReached = used >= dailyLimit;\nif (!limitReached) data.requestQuotaUsed = used + 1;\n\nreturn [{\n  json: {\n    ...request,\n    quota: {\n      date: today,\n      used: limitReached ? used : used + 1,\n      dailyLimit,\n      limitReached,\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -624,
        704
      ],
      "id": "0bb78474-d517-4800-b0f2-972a0a17131f",
      "name": "Check daily request limit"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
